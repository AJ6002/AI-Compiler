# ==============================================================================
# AICONNEX Compiler - Local Development Configuration
# Copy this file to .env for local overrides (NEVER commit actual secrets)
# ==============================================================================

# Application
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=dev_secret_key_change_in_production

# PostgreSQL Database
DATABASE_URL=postgresql://aiconnex:aiconnex_dev_password@localhost:5432/compiler_dev

# Storage Configuration (Local ObjectStore directory for development)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./infrastructure/local/data/raw

# Temporal Orchestration
TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default
