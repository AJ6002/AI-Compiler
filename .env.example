# ==============================================================================
# AICONNEX Compiler - Environment Configuration
# Copy this file to .env for local overrides (NEVER commit actual secrets)
# ==============================================================================

# Application & Service
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=dev_secret_key_change_in_production

# PostgreSQL Database
DATABASE_URL=postgresql://aiconnex:aiconnex_dev_password@localhost:5432/compiler_dev

# Storage Configuration (Local ObjectStore directory for development / S3 for prod)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./infrastructure/local/data/raw
S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Orchestration & Workflow
TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default

# Agent Investigation & Sandbox Environment (Phases 1-8)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
INVESTIGATION_MODEL_NAME=claude-3-7-sonnet-20250219
INVESTIGATION_MAX_TURNS=10
INVESTIGATION_TOKEN_BUDGET=50000
INVESTIGATION_TIMEOUT_SECONDS=60
SANDBOX_CONTAINER_IMAGE=aiconnex/compiler-sandbox:latest
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=1.0

# Compiler Safety Thresholds
MAX_ARCHIVE_SIZE_BYTES=524288000
MAX_UNCOMPRESSED_RATIO=100
MAX_PREVIEW_ROWS=50
DISCOVERY_AMBIGUITY_THRESHOLD=0.30
